// The std self-test (docs/std.md): ordinary erax asserts against the checked-in
// library, so it runs wherever the compiler runs. No framework and no pretty
// printing — two counters and a tally. `main` returns the number of failed
// checks, so the exit code is 0 exactly when the whole suite passed. The
// interpreter test pins the tally against the harness's own count.
let checks: i32 = 0;
let failed: i32 = 0;

fn check(cond: bool) {
    checks = checks + 1;
    if (!cond) {
        failed = failed + 1;
    }
}

fn main(): i32 {
    // Char: classification and conversion in one line each.
    check(std.is_digit('5'));
    check(!std.is_digit('x'));
    check(std.is_alpha('z'));
    check(!std.is_alpha('0'));
    check(std.is_alnum('7'));
    check(!std.is_alnum('-'));
    check(std.is_upper('Q'));
    check(!std.is_upper('q'));
    check(std.is_lower('q'));
    check(!std.is_lower('Q'));
    check(std.to_digit('7') == 7);
    check(std.to_digit('0') == 0);
    check(std.to_digit('x') == -1);
    check(std.to_upper('q') == 'Q');
    check(std.to_upper('3') == '3');
    check(std.to_lower('W') == 'w');
    check(std.to_lower('4') == '4');
    // Math: values the doc calls out, one check each.
    check(std.abs(-99) == 99);
    check(std.abs(4) == 4);
    check(std.min(3, -2) == -2);
    check(std.max(3, -2) == 3);
    check(std.min(3u64, 2u64) == 2u64);
    check(std.max(3u64, 2u64) == 3u64);
    check(std.pow(2, 10) == 1024);
    check(std.pow(10, 0) == 1);
    check(std.pow(0, 0) == 1);
    check(std.pow(2, 64) == 0);
    check(std.pow(3, 5) == 243);
    check(std.gcd(48, 18) == 6);
    check(std.gcd(0, 0) == 0);
    check(std.gcd(7, 0) == 7);
    // Heap: alloc hands back a zeroed block, a store and load round-trip through
    // it, free(null) does nothing, and a freed block is offered again.
    let p: ptr u8 = std.alloc(8);
    check(*p == 0);
    *p = 42;
    check(*p == 42);
    std.free(0 as ptr u8);
    std.free(p);
    let q: ptr u8 = std.alloc(8);
    check(q == p);
    // Output: one representative of each way of writing, so running the suite
    // by hand shows the numbers and the words.
    std.print(-42);
    std.print(' ');
    std.print(9223372036854775807i64);
    std.print(' ');
    std.print(18446744073709551615u64);
    std.print(' ');
    std.print(true);
    std.print(' ');
    std.print('A');
    std.print('\n');
    // The tally, then the suite's exit code is the failure count.
    std.print(checks);
    primitive print_char(' ');
    std.print(failed);
    std.print();
    return failed;
}
