// The erax standard library (docs/std.md): ordinary erax, compiled with every
// program. Its declarations live in `namespace std`, so callers reach them
// qualified (`std.print`). No globals, no `main`, no privileges — only primitives
// and functions in the same language user code has.

namespace std {

    // Output: the number or the word only, no spacing around it — composition is
    // the caller's (docs/std.md). Every integer prints through one recursive
    // template: the digits drop off the right, one per `print_char`, highest
    // first — `value / 10` is written before the digit that uses it. A negative
    // value prints its sign, then its magnitude read as a wrapping `u64`: for
    // `i64min` the sign-forward fold `0u64 - (value as u64)` is the magnitude
    // with nothing special to write. `primitive print` ends its line, so it stays
    // out of this. `bool` and `char` have their own declarations below, and any
    // other type's print is the caller's to compose.
    fn print<T extends Ordered & Arithmetic>(value: T) {
        if (value < 0) {
            primitive print_char('-');
            print(0u64 - (value as u64));
            return;
        }
        if (value >= 10) {
            print(value / 10);
        }
        primitive print_char((('0' as u64) + (value % 10) as u64) as char);
    }

    fn print(value: bool) {
        if (value) {
            primitive print_char('t');
            primitive print_char('r');
            primitive print_char('u');
            primitive print_char('e');
        } else {
            primitive print_char('f');
            primitive print_char('a');
            primitive print_char('l');
            primitive print_char('s');
            primitive print_char('e');
        }
    }

    // A char prints as the byte it is; print() is the newline.
    fn print(value: char) { primitive print_char(value); }
    fn print() { primitive print_char('\n'); }

    // Char: ASCII classification and conversion. A `char` is a byte, so the ranges
    // compare as the unsigned values they are.
    fn is_digit(c: char): bool { return c >= '0' && c <= '9'; }
    fn is_upper(c: char): bool { return c >= 'A' && c <= 'Z'; }
    fn is_lower(c: char): bool { return c >= 'a' && c <= 'z'; }
    fn is_alpha(c: char): bool { return is_upper(c) || is_lower(c); }
    fn is_alnum(c: char): bool { return is_alpha(c) || is_digit(c); }

    // `to_digit` returns the digit's value, or -1 when `c` is not one: `as` takes
    // the byte apart, so the value is computed rather than written out.
    fn to_digit(c: char): i32 {
        if (!is_digit(c)) {
            return -1;
        }
        return (c as i32) - ('0' as i32);
    }

    fn to_upper(c: char): char {
        if (is_lower(c)) {
            return c - ('a' - 'A');
        }
        return c;
    }

    fn to_lower(c: char): char {
        if (is_upper(c)) {
            return c + ('a' - 'A');
        }
        return c;
    }

    // Math, each a template over the capability its operations need; arithmetic
    // wraps exactly as the language says (language.md#semantics), so `abs(imin)`
    // is `-imin` wrapped, the way the machine takes it.
    fn abs<T extends Ordered & Negatable>(value: T): T {
        if (value < 0) {
            return -value;
        }
        return value;
    }

    fn min<T extends Ordered>(a: T, b: T): T {
        if (a < b) {
            return a;
        }
        return b;
    }

    fn max<T extends Ordered>(a: T, b: T): T {
        if (a > b) {
            return a;
        }
        return b;
    }

    // Exponentiation by squaring; every multiply is a wrapping one, so `pow` is
    // total: it answers the wrapped product for any inputs.
    fn pow<T extends Ordered & Arithmetic>(base: T, exponent: T): T {
        let result: T = 1;
        let factor: T = base;
        let e: T = exponent;
        while (e > 0) {
            if (e % 2 == 1) {
                result = result * factor;
            }
            e = e / 2;
            factor = factor * factor;
        }
        return result;
    }

    // Euclid's algorithm; `gcd(0, 0)` is `0`.
    fn gcd<T extends Arithmetic>(a: T, b: T): T {
        let x: T = a;
        let y: T = b;
        while (y != 0) {
            let t: T = x % y;
            x = y;
            y = t;
        }
        return x;
    }

    // `assert` writes nothing of its own: a failed assertion is the abort code and
    // nothing else, so print context first if it should say something.
    fn assert(cond: bool) {
        if (!cond) {
            primitive abort();
        }
    }

    // Heap: the allocator pair (`docs/primitive.md#alloc`) wrapped so a program
    // reaches it as `std.alloc` / `std.free` beside every other std name. The
    // block's contract is the primitive's — zeroed, rounded up to whole cells, at
    // least one — and `free` of the null pointer does nothing.
    fn alloc(bytes: u64): ptr u8 { return primitive alloc(bytes); }
    fn free<T>(p: ptr T) { primitive free(p); }


    // One owned T, stored in one raw cell. The slot owns the value until a
    // transfer explicitly moves it into a local or a caller's result.
    struct unique<T> {
        storage: ptr T;

        public new(value: T): unique<T> {
            const slot = alloc<T>(1);
            *slot = move value;
            return { storage: slot };
        }

        public fn get(): ref mut? T {
            assert(this.storage != 0 as ptr T);
            return ref mut? *this.storage;
        }

        public mut fn release(): T {
            assert(this.storage != 0 as ptr T);
            const value: T = move *this.storage;
            free(this.storage);
            this.storage = 0 as ptr T;
            return move value;
        }

        destructor {
            if (this.storage != 0 as ptr T) {
                const value: T = move *this.storage;
                free(this.storage);
            }
        }
    }

    // Exactly one slot is active until its payload is taken.
    struct Result<T, E> {
        success: bool;
        value_slot: ptr T;
        error_slot: ptr E;

        new(success: bool, value_slot: ptr T, error_slot: ptr E): Result<T, E> {
            return { success: success, value_slot: value_slot, error_slot: error_slot };
        }

        public static fn ok(value: T): Result<T, E> {
            const slot = alloc<T>(1);
            *slot = move value;
            return Result<T, E>.new(true, slot, 0 as ptr E);
        }

        public static fn err(error: E): Result<T, E> {
            const slot = alloc<E>(1);
            *slot = move error;
            return Result<T, E>.new(false, 0 as ptr T, slot);
        }

        public fn is_ok(): bool { return this.success; }

        public mut fn take_value(): T {
            assert(this.value_slot != 0 as ptr T);
            const value = move *this.value_slot;
            free(this.value_slot);
            this.value_slot = 0 as ptr T;
            return move value;
        }

        public mut fn take_error(): E {
            assert(this.error_slot != 0 as ptr E);
            const error = move *this.error_slot;
            free(this.error_slot);
            this.error_slot = 0 as ptr E;
            return move error;
        }

        destructor {
            if (this.value_slot != 0 as ptr T) {
                this.take_value();
            }
            if (this.error_slot != 0 as ptr E) {
                this.take_error();
            }
        }
    }

    // Every source value occupies one storage cell, including a record handle.
    // Raw relocation transfers each initialized element; it never clones it.
    struct vector<T> {
        storage: ptr T;
        count: u64;
        capacity_count: u64;

        public new(): vector<T> {
            return { storage: 0 as ptr T, count: 0u64, capacity_count: 0u64 };
        }

        public fn length(): u64 {
            return this.count;
        }

        public fn capacity(): u64 {
            return this.capacity_count;
        }

        public fn empty(): bool {
            return this.count == 0;
        }

        public mut fn reserve(capacity: u64) {
            if (capacity <= this.capacity_count) {
                return;
            }
            const replacement = alloc<T>(capacity);
            let i: u64 = 0;
            while (i < this.count) {
                const source = this.storage + i;
                const destination = replacement + i;
                *destination = move *source;
                i += 1;
            }
            free(this.storage);
            this.storage = replacement;
            this.capacity_count = capacity;
        }

        public mut fn push(value: T) {
            if (this.count == this.capacity_count) {
                const initial_capacity: u64 = 4;
                const growth_factor: u64 = 2;
                let capacity = initial_capacity;
                if (this.capacity_count != 0) {
                    capacity = this.capacity_count * growth_factor;
                    assert(capacity > this.capacity_count);
                }
                this.reserve(capacity);
            }
            const slot = this.storage + this.count;
            *slot = move value;
            this.count += 1;
        }

        public fn at(index: u64): ref mut? T {
            assert(index < this.count);
            const slot = this.storage + index;
            return ref mut? *slot;
        }

        public mut fn pop(): T {
            assert(this.count != 0);
            this.count -= 1;
            const slot = this.storage + this.count;
            return move *slot;
        }

        public mut fn clear() {
            while (this.count != 0) {
                this.count -= 1;
                const slot = this.storage + this.count;
                const value: T = move *slot;
            }
        }

        public fn clone(): vector<T> {
            let mut result = vector<T>.new();
            result.reserve(this.count);
            let i: u64 = 0;
            while (i < this.count) {
                const source = this.storage + i;
                result.push(*source);
                i += 1;
            }
            return move result;
        }

        destructor {
            this.clear();
            free(this.storage);
        }
    }

}  // namespace std
